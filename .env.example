# NetSage AI - Environment Variables Template
# Copy this file to .env and set your values

# Google Gemini API Key (Optional for Offline Mock Mode)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=

# Operation Mode: 'OFFLINE_MOCK' (default) or 'GEMINI_LIVE'
NETSAGE_MODE=OFFLINE_MOCK

# Environment: 'development' or 'production'
NETSAGE_ENV=development
